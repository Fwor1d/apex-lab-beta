{
  "name": "APEX LAB Phase 3",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "postCreateCommand": "if [ -f source/package.json ]; then cd source; fi; npm run setup:cloud",
  "forwardPorts": [
    4190
  ],
  "portsAttributes": {
    "4190": {
      "label": "APEX LAB · A/B telemetry",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false
      }
    }
  }
}
