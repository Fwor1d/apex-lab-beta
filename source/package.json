{
  "name": "apex-lab",
  "version": "0.16.0-phase4",
  "private": true,
  "type": "module",
  "description": "Единая локальная основа APEX LAB: UX Revision 5.2 и проверенное доменное ядро",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:security": "node scripts/check-security.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/baseline/*.test.mjs engine/tests/browser-unit/*.test.mjs",
    "test:e2e": "node scripts/browser-acceptance.mjs",
    "test:browser:unit": "node --test engine/tests/browser-unit/*.test.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "setup:cloud": "node scripts/setup-cloud.mjs",
    "test:import:e2e": "node scripts/import-acceptance.mjs",
    "test:analysis:e2e": "node scripts/analysis-acceptance.mjs",
    "test:trajectory:e2e": "node scripts/trajectory-acceptance.mjs"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@playwright/test": "1.64.0",
    "animejs": "4.5.0",
    "esbuild": "0.28.2",
    "js-sha256": "0.11.1",
    "motion": "14.2.0",
    "prettier": "3.9.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
